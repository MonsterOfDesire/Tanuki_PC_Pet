{
  "schema_version": 1,
  "status": "draft",
  "purpose": "TanukiProject trophy cabinet achievement definitions",
  "source_catalog": "race_achievements.json",
  "source_catalog_role": "asset provenance only; app achievement rules are defined in this file",
  "global_eligibility": {
    "progress_scope": "per_achievement_world_mode",
    "world_modes_are_isolated": true,
    "definition_scope": "single_world_mode",
    "definitions_are_shared_between_modes": false,
    "similar_rules_require_distinct_achievement_ids": true,
    "require_full_session_at_1x": true,
    "exclude_source_kinds": [
      "settings_preview",
      "settings_test_control",
      "debug",
      "test"
    ]
  },
  "implementation_status_values": {
    "ready_existing_event": "Existing canonical event and payload are sufficient.",
    "ready_live_event": "Canonical gameplay event is connected to the live achievement Runtime.",
    "needs_gameplay_event": "The gameplay exists but needs an achievement-facing canonical event or payload.",
    "ready_evaluator": "The pure evaluator is implemented; live Runtime event or snapshot wiring may still be pending.",
    "reserved": "Trophy asset is intentionally not assigned yet."
  },
  "cabinet": {
    "entry_point": "family_summary_achievement_slot",
    "presentation": "dedicated_trophy_cabinet_window",
    "design_document": "../../docs/ACHIEVEMENT_UI_DESIGN.md",
    "skin": {
      "background": {
        "image": "achievement.png",
        "source_size": [
          1600,
          900
        ],
        "fit": "contain"
      },
      "foreground": {
        "image": "achievement_char.gif",
        "source_size": [
          500,
          500
        ],
        "animated": true,
        "frame_count": 8,
        "frame_duration_ms": 100,
        "layer": "fixed_bottom_right"
      },
      "content_rect_normalized": [
        0.05,
        0.055,
        0.68,
        0.775
      ],
      "foreground_rect_normalized": [
        0.69,
        0.465,
        0.31,
        0.525
      ]
    },
    "mode_tabs": [
      "sandbox",
      "golden_legend"
    ],
    "shelf_order": [
      "G1",
      "G2",
      "G3"
    ],
    "locked_trophy": {
      "render": "black_alpha_silhouette",
      "show_title_on_hover": false,
      "show_description_on_hover": false,
      "show_progress_on_hover": false,
      "show_acquisition_method_on_hover": false,
      "accessible_label_zh_tw": "未取得的 {tier} 獎盃",
      "locked_information_policy": "do_not_reveal_title_condition_or_progress"
    },
    "unassigned_trophy": {
      "render": "empty_pedestal",
      "label_zh_tw": "後續追加",
      "must_not_render_as_locked_achievement": true
    },
    "unlocked_trophy": {
      "render": "original_color",
      "show_unlocked_at": true,
      "show_world_mode": true,
      "show_acquisition_method_on_hover": true
    },
    "asset_fit": "crop transparent bounds in memory, then fit while preserving aspect ratio",
    "refresh_policy": "refresh on unlock, mode change, tier change, or window show; never rebuild every second"
  },
  "mode_catalogs": {
    "sandbox": {
      "assigned_achievement_count": 24,
      "notes": "Current non-economy gameplay achievement draft. Definitions and unlocks belong only to Sandbox."
    },
    "golden_legend": {
      "assigned_achievement_count": 2,
      "notes": "Current draft only includes Rudolf work achievements. More definitions wait for Golden Legend 2.0.0 design."
    }
  },
  "tiers": {
    "G3": {
      "difficulty": "introductory",
      "design_rule_zh_tw": "首次完成、首次看見或容易自然發生的單一步驟成就。"
    },
    "G2": {
      "difficulty": "intermediate",
      "design_rule_zh_tw": "需要累積、蒐集不同條件，或讓多名角色參與的中期成就。"
    },
    "G1": {
      "difficulty": "advanced",
      "design_rule_zh_tw": "需要稀有同場條件、跨系統完成，或長期蒐集的高難度成就。"
    }
  },
